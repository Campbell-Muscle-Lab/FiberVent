{
    "layout":
    {
        "fig_width": 2.5,
        "x_to_y_ratio": 1.1,
        "padding_left": 0.7,
        "padding_right": 0.9,
        "padding_top": [0.2, 0.07],
        "padding_bottom": [0.05, 0.5]
    },
    "x_display":{
        "global_x_field": "time",
        "label": "Time (s)",
        "ticks": [3.9, 4.05],
        "decimal_places": 2

    },
    "formatting":
    {
        "label_font_size": 9,
        "x_axis_offset": 0.1,
        "x_label_offset": -0.5,
        "x_tick_length": 0.1,
        "x_tick_label_vertical_offset": -0.12,
        "y_axis_offset": 0.2,
        "y_label_offset": -0.55,
        "y_tick_length": 0.1,
        "y_tick_label_horizontal_offset": -0.16,
        "tick_font_size": 9,
        "legend_font_size": 7,
        "legend_alignment": "top_left",
        "legend_position": [1.1, 1.0],
        "legend_icon_col_width": 5
    },
    "panels":
    [
        {
            "column": 1,
            "y_info":
            {
                "label": "Ventricular\npressure\n(mmHg)",
                "ticks": [0, 130],
                "series":
                [
                    
                    {
                        "field": "pressure_0",
                        "processing": "smooth"
                    }
                ]
            }
        },
        {
            "column": 1,
            "y_info":
            {
                "label": "Arterial\npressure\n(mmHg)",
                "ticks": [0, 130],
                "series":
                [
                    {
                        "field": "pressure_1"
                    }
                ]
            }
        },
        {
            "column": 1,
            "y_info":
            {
                "label": "Cytosolic\n[Ca^{2+}]\n(µm)",
                "series":
                [
                    {
                        "field": "memb_Ca_cytosol",
                        "scaling_factor": 1e6,
                        "xstyle": "envelope"
                    }
                ]
            }
        },
        {
            "column": 1,
            "y_info":
            {
                "label": "Half-\nsarcomere\nlength\n(nm)",
                "scaling_type": "close_fit",
                "ticks": [850, 1150],
                "series":
                [
                    {
                        "field": "fs_hs_length"                        
                    }
                ]
            }
        },
        {
            "column": 1,
            "y_info":
            {
                "label": "Thin\nfilament\nstate\nproportions",
                "series":
                [
                    {
                        "field": "fs_hs_a_pop_0",
                        "field_label": "Inactive",
                        "xstyle": "envelope"
                    },
                    {
                        "field": "fs_hs_a_pop_1",
                        "field_label": "Active",
                        "xstyle": "envelope"
                    }
                ]
            }
        },
        {
            "column": 1,
            "y_info":
            {
                "label": "Myosin\nstate\nproportions",
                "legend_on_for_datasets": [1, 0],
                "series":
                [
                    {
                        "field": "fs_hs_m_pop_0",
                        "field_label": "OFF"
                    },
                    {
                        "field": "fs_hs_m_pop_1",
                        "field_label": "DRX"
                    },
                    {
                        "field": "fs_hs_m_pop_2",
                        "field_label": "Pre-force"
                    },
                    {
                        "field": "fs_hs_m_pop_3",
                        "field_label": "Post-force"
                    }
                ]
            }
        }
    ]
}
